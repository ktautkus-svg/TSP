# Tik serverio / benchmark proceso aplinkai. Nedėkite šių reikšmių į Expo EXPO_PUBLIC_*.
HERE_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GATEWAY_APP_SECRET=
# Privalomas tik pirmam administratoriui sukurti. Esamos paskyros veikia ir be jo.
# 6–8 skaitmenys, ne 123456 ir ne vienodi skaitmenys.
TSP_INITIAL_ADMIN_PIN=

# Development: LAN gateway gali veikti be kliento paslapties, bet vis tiek taikomi
# body, rate, timeout ir endpoint limitai. Produkcinis PWA serveris gateway laiko
# 127.0.0.1 ir saugo /api/* employee sesija (GATEWAY_AUTH_MODE=none).
GATEWAY_ENV=development
GATEWAY_AUTH_MODE=none
GATEWAY_ALLOWED_ORIGIN=*

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
EXPO_PUBLIC_GATEWAY_URL=http://<LAN_IP>:8787
# Select exactly one paid matrix provider. Synthetic is off unless the driver
# confirms it, or EXPO_PUBLIC_ALLOW_SYNTHETIC_FALLBACK=1 for local development.
EXPO_PUBLIC_ROUTING_PROVIDER=google
EXPO_PUBLIC_ALLOW_SYNTHETIC_FALLBACK=
GATEWAY_TIMEOUT_MS=15000
GATEWAY_MAX_STOPS=25
GATEWAY_MAX_BODY_BYTES=262144
# Vieno kliento (IP) bendra apsauga nuo užklausų audros ir atskiri
# 60 sekundžių endpointų limitai vieno naudotojo aplikacijai.
GATEWAY_RATE_LIMIT_PER_MINUTE=800
GATEWAY_GEOCODE_RATE_LIMIT_PER_MINUTE=600
GATEWAY_MATRIX_RATE_LIMIT_PER_MINUTE=30
GATEWAY_POLYLINE_RATE_LIMIT_PER_MINUTE=30
GATEWAY_OCR_RATE_LIMIT_PER_MINUTE=20
GATEWAY_CACHE_DIRECTORY=.gateway-cache/matrices
GATEWAY_RESPONSE_CACHE_DIRECTORY=.gateway-cache/responses
GATEWAY_USAGE_DIRECTORY=.gateway-cache/usage
# Real provider calls remain blocked unless this is explicitly set to 1.
GATEWAY_REAL_PROVIDER_ARMED=0
# Matrix elements are the conservative universal usage unit when provider prices are unknown.
GATEWAY_DAILY_USAGE_UNITS=7290
GATEWAY_WEEKLY_USAGE_UNITS=36450
# Optional hard money budgets in cents; leave blank until provider pricing is verified.
GATEWAY_DAILY_BUDGET_CENTS=
GATEWAY_WEEKLY_BUDGET_CENTS=
GATEWAY_GEOCODE_MAX_ADDRESS_LENGTH=300
GATEWAY_GEOCODE_CACHE_TTL_MS=2592000000
GATEWAY_POLYLINE_CACHE_TTL_MS=900000
GATEWAY_LIVE_CACHE_TTL_MS=900000
GATEWAY_NO_TRAFFIC_CACHE_TTL_MS=86400000

# Neprivaloma kainos apskaita; sumos sąmoningai nehardcodinamos.
ROUTING_PRICING_CURRENCY=
HERE_PRICE_PER_1000_ELEMENTS=
GOOGLE_PRICE_PER_1000_ELEMENTS=
