{
  "name": "logistikos-pristatymai",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.9",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:schema": "node ./scripts/validate-schema.mjs",
    "experiment:routing": "tsx ./experiments/provider-comparison/run.ts",
    "benchmark:routing": "tsx ./scripts/benchmark-routing.ts",
    "gateway:dev": "tsx ./gateway/server.ts",
    "gateway:test": "vitest run tests/gateway",
    "benchmark:routing:synthetic": "tsx ./scripts/benchmark-routing-providers.ts --mode=synthetic",
    "benchmark:routing:real": "tsx ./scripts/benchmark-routing-providers.ts --mode=real",
    "benchmark:routing:cache": "tsx ./scripts/benchmark-routing-providers.ts --mode=cache-only",
    "benchmark:routing:refresh": "tsx ./scripts/benchmark-routing-providers.ts --mode=refresh",
    "benchmark:import": "tsx ./scripts/benchmark-import.ts",
    "pilot:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pilot-ios.ps1",
    "pilot:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pilot-stop.ps1",
    "pwa:build": "node ./scripts/pwa-build.mjs",
    "pwa:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pwa-serve.ps1",
    "pwa:test": "vitest run tests/pwa tests/unit/pwa-backup.test.ts && node ./scripts/scan-production-bundle.mjs",
    "cloud-run:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cloud-run-deploy.ps1",
    "cloud-run:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cloud-run-status.ps1"
  },
  "private": true
}
